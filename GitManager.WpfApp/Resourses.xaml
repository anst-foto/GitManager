<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Button">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="Background" Value="#bb9457"/>
        <Setter Property="Foreground" Value="#fff4a0"/>
        <Setter Property="BorderBrush" Value="#432818"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="repositories" TargetType="ListBox">
        <Setter Property="Background" Value="#bb9457"/>
        <Setter Property="Foreground" Value="#fff4a0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="button_panel" TargetType="StackPanel">
        <Setter Property="Background" Value="#916241"/>
    </Style>
    <Style x:Key="username_text" TargetType="TextBlock">
        <Setter Property="Background" Value="#bb9457"/>
        <Setter Property="Foreground" Value="#fff4a0"/>
    </Style>
    <Style x:Key="users_panel" TargetType="StackPanel">
        <Setter Property="Background" Value="#bb9457"/>
    </Style>
    <Style x:Key="user_button" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
