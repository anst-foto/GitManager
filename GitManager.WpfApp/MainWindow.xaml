<Window x:Class="GitManager.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="MainWindow"
        Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Background" Value="#bb9457"/>
            <Setter Property="Foreground" Value="#fff4a0"/>
            <Setter Property="BorderBrush" Value="#432818"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0"
                    Background="#99582a">
            <StackPanel>
                <ListBox Background="Transparent">
                    <ListBoxItem HorizontalContentAlignment="Center">
                        <Button Background="Transparent"
                                BorderThickness="0">
                            <Ellipse Height="60"
                                     Width="60"
                                     Fill="#432818">
                            </Ellipse>
                        </Button>
                    </ListBoxItem>
                    <TextBlock Text="Имя пользователя" Background="#bb9457" Foreground="#fff4a0"/>
                </ListBox>
            </StackPanel>
            <Button Background="Transparent"
                    BorderThickness="0">
                <Ellipse Height="30"
                         Width="30"
                         Fill="Black"
                         HorizontalAlignment="Center">
                </Ellipse>
            </Button>
        </StackPanel>
        <ListBox Grid.Column="1"
                 SelectionMode="Multiple"
                 Background="#bb9457"
                 Foreground="#fff4a0"
                 BorderThickness="0">
            <ListBoxItem Content="Репозиторий 1"/>
            <ListBoxItem Content="Репозиторий 2"/>
        </ListBox>
        <StackPanel Grid.ColumnSpan="2"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Background="#916241">
            <!-- <Button Content="Добавить"/>-->
            <Button Content="Удалить"/>
            <Button Content="Изменить"/>
        </StackPanel>
    </Grid>
</Window>
