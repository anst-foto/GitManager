<Window x:Class="GitManager.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resourses.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource ResourceKey=button_panel}">
            <StackPanel>
                <ListBox Background="Transparent">
                    <ListBoxItem HorizontalContentAlignment="Center">
                        <Button Style="{StaticResource ResourceKey=user_button}">
                            <Ellipse Height="60"
                                     Width="60"
                                     Fill="#432818">
                            </Ellipse>
                        </Button>
                    </ListBoxItem>
                    <TextBlock Text="Имя пользователя"
                               Style="{StaticResource ResourceKey=username_text}"/>
                </ListBox>
            </StackPanel>
            <Button Style="{StaticResource ResourceKey=user_button}">
                <Ellipse Height="30"
                         Width="30"
                         Fill="Black"
                         HorizontalAlignment="Center">
                </Ellipse>
            </Button>
        </StackPanel>
        <ListBox Grid.Column="1"
                 Grid.Row="0"
                 SelectionMode="Multiple"
                 Style="{StaticResource ResourceKey=repositories}">
            <ListBoxItem Content="Репозиторий 1"/>
            <ListBoxItem Content="Репозиторий 2"/>
        </ListBox>
        <StackPanel Grid.ColumnSpan="2"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Style="{StaticResource ResourceKey=button_panel}">
            <Button Content="Удалить"/>
            <Button Content="Изменить"/>
        </StackPanel>
    </Grid>
</Window>
